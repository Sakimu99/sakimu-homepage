# ============================================================
#  咲梦工作室官网 · 支付服务配置（Node 本地开发 / 自建服务器用）
#  用法：复制本文件为 .env，填入真实值。.env 已在 .gitignore 中。
#
#  线上跑的是 Cloudflare Pages Functions，配置不在这里：
#    - 公开变量 + KV 绑定 → wrangler.toml
#    - 机密（私钥、后台口令）→ wrangler pages secret put
#  见 docs/alipay-payment.md 第 3 章。
# ============================================================

# ---------- 服务 ----------
# 本地端口；线上通常由 Nginx / Cloudflare 反代到它
PORT=3001

# 站点对外访问地址（不带结尾斜杠）。
# 这个值决定 notify_url / return_url 与支付完成后的跳转地址，
# 线上必须是公网可访问的 HTTPS 域名，例如 https://example.com
PUBLIC_BASE_URL=http://127.0.0.1:3001

# 订单数据目录（JSON 文件），默认 ./data
DATA_DIR=data

# 运营后台 /deposit/admin 的口令；留空则后台关闭
ADMIN_TOKEN=

# ---------- 支付宝应用 ----------
# sandbox = 沙箱调试，prod = 生产
ALIPAY_ENV=sandbox

# 开放平台应用 APPID（沙箱与线上不同）
ALIPAY_APP_ID=

# 应用私钥（PKCS8 / PKCS1 均可，单行 Base64 或 PEM 都支持）
ALIPAY_PRIVATE_KEY=

# 支付宝公钥（注意：是「支付宝公钥」，不是应用公钥）
ALIPAY_PUBLIC_KEY=

# 签名算法，默认 RSA2
ALIPAY_SIGN_TYPE=RSA2

# 一般无需设置，留空会按 ALIPAY_ENV 自动选择：
#   沙箱 https://openapi-sandbox.dl.alipaydev.com/gateway.do
#   生产 https://openapi.alipay.com/gateway.do
# ALIPAY_GATEWAY=

# 如需使用已备案的独立回调地址，可单独覆盖（留空自动拼接 PUBLIC_BASE_URL）
# ALIPAY_NOTIFY_URL=https://example.com/api/alipay/notify
# ALIPAY_RETURN_URL=https://example.com/api/alipay/return

# ---------- 定金 ----------
# 固定定金金额，前端无法修改；改这里才会变
DEPOSIT_AMOUNT=10.00
DEPOSIT_SUBJECT=咲梦工作室 · 项目预定定金
# 相对超时时间：超时后支付宝侧自动关闭交易
DEPOSIT_TIMEOUT=30m
